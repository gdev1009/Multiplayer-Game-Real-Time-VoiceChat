# Client app configuration. Copy this file to `.env` and fill in real values.
#
# WARNING: app/.env is bundled INTO the app (see pubspec.yaml `assets: - .env`),
# so it ships to every device. Only put PUBLIC / TTS-restricted keys here for alpha.
# Production ElevenLabs keys should live in a Supabase Edge Function, not the APK.

# Supabase project URL (Settings -> API -> Project URL)
SUPABASE_URL=https://your-ref.supabase.co

# Supabase anon/public key (Settings -> API). Safe for the client.
SUPABASE_ANON_KEY=your-anon-public-key

# ElevenLabs — Ronna's Game Show Host voice (TTS-only key for alpha).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=DHeX7CCuOXUPRpnb0AdT
