# Client app configuration. Copy this file to `.env` and fill in real values.
#
# WARNING: app/.env is bundled INTO the app (see pubspec.yaml `assets: - .env`),
# so it ships to every device. Only put PUBLIC, client-safe values here.
# Never put server secrets (service-role keys, Mailgun API key, etc.) in this
# file — those belong in supabase/functions/.env instead.

# Supabase project URL (Settings -> API -> Project URL)
SUPABASE_URL=https://your-ref.supabase.co

# Supabase anon/public key (Settings -> API). Safe for the client.
SUPABASE_ANON_KEY=your-anon-public-key

# Set to true only for local demos to relax the auth flow. Leave unset in prod.
EASY_TEST_AUTH=false
