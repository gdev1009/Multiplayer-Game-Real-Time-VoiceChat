# Server-side secrets for Supabase Edge Functions.
# Copy this file to `.env` in the same folder and fill in real values.
# The real .env here is gitignored and is NEVER bundled into the app.
#
# Load locally:  supabase functions serve --env-file ./supabase/functions/.env
# Push to Supabase: supabase secrets set --env-file ./supabase/functions/.env

# --- Mailgun (REST API) ---------------------------------------------------
# API key from the Mailgun dashboard (Sending -> Domain settings -> API keys).
MAILGUN_API_KEY=key-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your verified Mailgun sending domain, e.g. mg.grandmamac.com
MAILGUN_DOMAIN=mg.example.com

# Mailgun API base URL. Use https://api.eu.mailgun.net for EU-region domains.
MAILGUN_BASE_URL=https://api.mailgun.net

# The From address shown to recipients.
MAILGUN_SENDER=Match Word <no-reply@mg.example.com>

# --- Supabase Auth "Send Email" hook -------------------------------------
# Shared secret Supabase signs the hook payload with (Auth -> Hooks).
# Generate with: openssl rand -base64 48    Format: v1,whsec_<base64secret>
SEND_EMAIL_HOOK_SECRET=v1,whsec_xxxxxxxxxxxxxxxxxxxxxxxx
